{
  "name": "@homelearn/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --ios",
    "start:device": "expo start --dev-client --lan",
    "run:ios:device": "expo run:ios --device",
    "build": "expo export --platform ios",
    "build:eas:simulator": "npx eas-cli@latest build --platform ios --profile preview-simulator",
    "build:eas:device": "npx eas-cli@latest build --platform ios --profile preview-device",
    "build:eas:production": "npx eas-cli@latest build --platform ios --profile production",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.28",
    "better-auth": "1.7.28",
    "expo": "58.0.26",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-linking": "~58.0.17",
    "expo-network": "~58.0.6",
    "expo-secure-store": "~58.0.3",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.15",
    "test-renderer": "1.0.0"
  },
  "jest": {
    "preset": "jest-expo/ios",
    "testMatch": [
      "**/*.test.tsx"
    ]
  }
}
