generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String         @id @db.VarChar(200)
  name               String         @db.VarChar(255)
  email              String         @unique @db.VarChar(255)
  emailVerified      Boolean        @default(false)
  image              String?        @db.Text
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(3)
  sessions           Session[]
  accounts           Account[]
  familyMemberships  FamilyMember[]

  @@map("user")
}

model Session {
  id        String   @id @db.VarChar(200)
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?  @db.VarChar(255)
  userAgent String?  @db.Text
  userId    String   @db.VarChar(200)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @db.VarChar(200)
  accountId             String    @db.VarChar(255)
  providerId            String    @db.VarChar(255)
  userId                String    @db.VarChar(200)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @db.VarChar(200)
  identifier String   @db.VarChar(255)
  value      String   @db.Text
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

model Family {
  id        String         @id @db.VarChar(200)
  name      String         @db.VarChar(200)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  members   FamilyMember[]
  lessons   LessonVersion[]
  plans     LearningPlan[]
  activities Activity[]
  experiences LearningExperience[]
  curriculumVersions CurriculumVersion[]

  @@map("Family")
}

model FamilyMember {
  userId    String   @db.VarChar(200)
  familyId  String   @db.VarChar(200)
  role      String   @default("parent") @db.VarChar(40)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@id([userId, familyId])
  @@index([familyId, userId])
  @@map("FamilyMember")
}

model Curriculum {
  id        String              @id @db.VarChar(200)
  versions  CurriculumVersion[]
  createdAt DateTime            @default(now()) @db.Timestamptz(3)
}

model LessonVersion {
  id                  String                    @id @db.VarChar(300)
  lessonKey           String                    @db.VarChar(200)
  familyId            String                    @db.VarChar(200)
  versionLabel        String                    @db.VarChar(40)
  title               String                    @db.VarChar(300)
  subject             String                    @db.VarChar(120)
  strand              String                    @db.VarChar(160)
  learningLevel       String                    @db.VarChar(80)
  learningGoal        String                    @db.VarChar(1000)
  successCriteria     Json
  description         String?                   @db.Text
  materials           Json
  steps               Json
  adaptation          String?                   @db.Text
  estimatedMinutes    Int?
  creationMethod      String                    @db.VarChar(20)
  aiProvider          String?                   @db.VarChar(80)
  aiModel             String?                   @db.VarChar(120)
  parentApprovedAt    DateTime?                 @db.Timestamptz(3)
  createdAt           DateTime                  @default(now()) @db.Timestamptz(3)
  family              Family                    @relation(fields: [familyId], references: [id], onDelete: Restrict)
  plannedActivities   Activity[]
  learningRecords     LearnerLearningRecord[]

  @@unique([familyId, lessonKey, versionLabel])
  @@unique([familyId, id])
  @@index([familyId, createdAt])
}

model CurriculumVersion {
  id            String                @id @db.VarChar(240)
  curriculumId  String                @db.VarChar(200)
  familyId      String?               @db.VarChar(200)
  versionLabel  String                @db.VarChar(100)
  sourceKind    String                @db.VarChar(20)
  publisher     String                @db.VarChar(200)
  sourceUrl     String?               @db.Text
  effectiveFrom DateTime              @db.Date
  effectiveTo   DateTime?             @db.Date
  retrievedAt   DateTime              @db.Timestamptz(3)
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)
  family        Family?               @relation(fields: [familyId], references: [id], onDelete: Restrict)
  curriculum    Curriculum            @relation(fields: [curriculumId], references: [id], onDelete: Restrict)
  outcomes      LearningOutcome[]
  learnerGoals  CurriculumLearnerGoal[]

  @@unique([curriculumId, versionLabel])
  @@index([curriculumId, effectiveFrom])
  @@index([familyId, curriculumId])
}

model LearningOutcome {
  id                  String              @id @db.VarChar(300)
  curriculumVersionId String              @db.VarChar(240)
  code                String              @db.VarChar(100)
  title               String              @db.VarChar(500)
  description         String?             @db.Text
  version             CurriculumVersion  @relation(fields: [curriculumVersionId], references: [id], onDelete: Restrict)
  learnerGoals        CurriculumLearnerGoal[]

  @@unique([curriculumVersionId, code])
  @@unique([curriculumVersionId, id])
  @@index([curriculumVersionId])
}

// Family ownership and learner foreign keys are intentionally deferred until
// authentication/family persistence is designed. This table is not exposed by API.
model CurriculumLearnerGoal {
  id                  String            @id @db.VarChar(200)
  learnerId           String            @db.VarChar(200)
  curriculumVersionId String            @db.VarChar(240)
  outcomeId           String            @db.VarChar(300)
  createdAt           DateTime          @db.Timestamptz(3)
  version             CurriculumVersion @relation(fields: [curriculumVersionId], references: [id], onDelete: Restrict)
  outcome             LearningOutcome   @relation(fields: [curriculumVersionId, outcomeId], references: [curriculumVersionId, id], onDelete: Restrict)

  @@unique([learnerId, outcomeId])
  @@index([learnerId, createdAt])
}

model LearningPlan {
  id        String     @id @db.VarChar(200)
  familyId  String     @db.VarChar(200)
  title     String     @db.VarChar(300)
  startsOn  DateTime   @db.Date
  endsOn    DateTime   @db.Date
  status    String     @db.VarChar(20)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  family    Family     @relation(fields: [familyId], references: [id], onDelete: Restrict)
  activities Activity[]
  @@index([familyId, startsOn])
  @@unique([familyId, id])
}

model Activity {
  id          String              @id @db.VarChar(200)
  familyId    String              @db.VarChar(200)
  planId      String              @db.VarChar(200)
  title       String              @db.VarChar(500)
  lessonVersionId String?         @db.VarChar(300)
  catalogLessonRef String?         @db.VarChar(300)
  schedule    Json?
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  family      Family              @relation(fields: [familyId], references: [id], onDelete: Restrict)
  plan        LearningPlan        @relation(fields: [familyId, planId], references: [familyId, id], onDelete: Restrict)
  assignments ActivityAssignment[]
  revisions   ActivityScheduleRevision[]
  experiences LearningExperience[]
  lessonVersion LessonVersion?    @relation(fields: [familyId, lessonVersionId], references: [familyId, id], onDelete: Restrict)
  @@index([familyId, planId])
  @@unique([familyId, id])
  @@index([lessonVersionId])
  @@index([catalogLessonRef])
}

model ActivityAssignment {
  activityId String   @db.VarChar(200)
  learnerId  String   @db.VarChar(200)
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  @@id([activityId, learnerId])
  @@index([learnerId])
}

model ActivityScheduleRevision {
  id          String   @id @db.VarChar(200)
  activityId  String   @db.VarChar(200)
  previous    Json?
  next        Json?
  changedAt   DateTime @db.Timestamptz(3)
  changedBy   String   @db.VarChar(200)
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  @@index([activityId, changedAt])
}

model LearningExperience {
  id        String                 @id @db.VarChar(200)
  familyId  String                 @db.VarChar(200)
  happenedAt DateTime              @db.Timestamptz(3)
  activityId String?               @db.VarChar(200)
  title     String                 @db.VarChar(500)
  family    Family                 @relation(fields: [familyId], references: [id], onDelete: Restrict)
  activity  Activity?              @relation(fields: [familyId, activityId], references: [familyId, id], onDelete: Restrict)
  records   LearnerLearningRecord[]
  @@index([familyId, happenedAt])
}

model LearnerLearningRecord {
  id                   String             @id @db.VarChar(200)
  experienceId         String             @db.VarChar(200)
  learnerId             String             @db.VarChar(200)
  observation           String?            @db.Text
  completed             Boolean
  lessonVersionId       String?            @db.VarChar(300)
  catalogLessonRef      String?            @db.VarChar(300)
  curriculumVersionId   String?            @db.VarChar(240)
  configurationSnapshot Json?
  experience            LearningExperience @relation(fields: [experienceId], references: [id], onDelete: Restrict)
  assessments           OutcomeAssessment[]
  lessonVersion         LessonVersion?    @relation(fields: [lessonVersionId], references: [id], onDelete: Restrict)
  @@unique([experienceId, learnerId])
  @@index([learnerId])
  @@index([lessonVersionId])
  @@index([catalogLessonRef])
}

model OutcomeAssessment {
  id               String                @id @db.VarChar(200)
  learnerRecordId  String                @db.VarChar(200)
  outcomeId        String                @db.VarChar(300)
  assessedAt       DateTime              @db.Timestamptz(3)
  assessedBy       String                @db.VarChar(200)
  judgement        String                @db.VarChar(30)
  rationale        String?               @db.Text
  learnerRecord   LearnerLearningRecord  @relation(fields: [learnerRecordId], references: [id], onDelete: Restrict)
  @@index([learnerRecordId, assessedAt])
}
