{
  "name": "@homelearn/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:postgres": "node --env-file=.env ../../node_modules/vitest/vitest.mjs run test/postgres-persistence.test.ts",
    "db:generate": "prisma generate",
    "auth:provision": "tsx src/modules/identity/provision-parent.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.28",
    "@better-auth/prisma-adapter": "1.7.28",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "1.7.28",
    "dotenv": "^18.0.10",
    "fastify": "5.12.8",
    "postgres": "3.4.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "prisma": "^7.10.1",
    "tsx": "4.23.15"
  }
}
