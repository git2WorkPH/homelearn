# Copy to .env and replace the local-only database password before starting Postgres.
# Keep this file free of real credentials; .env is ignored by Git.
HOMELEARN_DB_PASSWORD=change-me-local-only

# API server. HOST defaults to loopback to keep this unauthenticated API local.
HOST=127.0.0.1
PORT=3000

# Used by the API and Prisma CLI. Keep credentials URL-encoded when necessary.
DATABASE_URL=postgresql://homelearn:change-me-local-only@127.0.0.1:5432/homelearn?schema=public

# Optional: override for a simulator/device that can reach the development machine.
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
