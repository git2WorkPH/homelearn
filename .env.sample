# Copy to .env and replace the local-only database password before starting Postgres.
# Keep this file free of real credentials; .env is ignored by Git.
HOMELEARN_DB_PASSWORD=change-me-local-only

# API server. Keep loopback binding until secure LAN access is configured.
HOST=127.0.0.1
PORT=3000

# Better Auth. Generate a unique random value with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://127.0.0.1:3000

# Used by the API and Prisma CLI. Keep credentials URL-encoded when necessary.
DATABASE_URL=postgresql://homelearn:change-me-local-only@127.0.0.1:5432/homelearn?schema=public

# iOS simulator default. Physical-device access still requires a separate secure LAN setup.
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000

# Optional local lesson drafting. The API only connects to loopback Ollama.
OLLAMA_MODEL=llama3.2
